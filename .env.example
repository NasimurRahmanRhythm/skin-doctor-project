# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS entirely, so it must never be imported into a
# client component or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the keep-alive cron route, so only Vercel Cron can call it.
# Generate with:  node -e "console.log(crypto.randomUUID())"
CRON_SECRET=your-random-secret
