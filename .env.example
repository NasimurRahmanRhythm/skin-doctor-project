# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS entirely, so it must never be imported into a
# client component or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the keep-alive cron route, so only Vercel Cron can call it.
# Generate with:  node -e "console.log(crypto.randomUUID())"
CRON_SECRET=your-random-secret

# Server-only. Google Places API (New) key for the website's Reviews section.
# Google Cloud Console -> enable "Places API (New)" -> Credentials -> API key,
# restricted to that API. Without it the Reviews section simply stays hidden.
GOOGLE_PLACES_API_KEY=

# Meta (Facebook / Instagram) Pixel. Public: it is in every page's script.
# Leave empty to use the clinic's pixel built into lib/site/pixel.ts.
NEXT_PUBLIC_META_PIXEL_ID=

# Server-only. Meta Conversions API access token: Events Manager -> the pixel
# -> Settings -> Conversions API -> Generate access token. Never NEXT_PUBLIC_.
# Without it only the browser pixel runs.
META_CAPI_ACCESS_TOKEN=

# Optional. Only while checking Events Manager -> Test events; remove after.
META_CAPI_TEST_CODE=
